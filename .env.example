# Copy to .env.local and fill in. Never commit .env.local.
# Variables are added phase by phase; empty ones are not needed yet.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Week 4: database, email, rate limiting
DATABASE_URL=            # Neon pooled connection string (dev branch locally)
DATABASE_URL_UNPOOLED=   # Neon direct (non-pooled) connection string, used by migrations
RESEND_API_KEY=
CONTACT_TO_EMAIL=        # must be your Resend account email until a domain is verified
CONTACT_FROM_EMAIL=      # optional; defaults to Resend's onboarding@resend.dev sender
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Week 5: admin auth and images
AUTH_SECRET=             # npx auth secret
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_LOGIN=      # the only GitHub username allowed into /admin
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Week 6: AI chatbot
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_CHAT_MODEL=       # optional; defaults to gemini-3.5-flash-lite
GROQ_API_KEY=            # optional; when set, Groq writes chat answers (Gemini still does search)
GROQ_CHAT_MODEL=         # optional; defaults to openai/gpt-oss-120b
